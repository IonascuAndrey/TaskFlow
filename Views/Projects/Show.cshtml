@model TaskFlow.Models.Project

<h2>@Model.Title</h2
<p>@Model.Description</p>

<h3>Tasks</h3>
<ul>
    @foreach (var task in Model.AppTasks)
    {
        <li>@task.Title</li>
        <td>
            <!-- Show button -->
            <a href="@Url.Action("Show", "AppTasks", new { id = task.Id })" class="btn btn-info">Show</a>
        </td>

        <td>
            <!-- Edit button -->
            <a href="@Url.Action("Edit", "AppTasks", new { id = task.Id })" class="btn btn-warning">Edit</a>
        </td>

        <td>
            <!-- Delete button -->
            <form action="@Url.Action("Delete", "AppTasks", new { id = task.Id })" method="post" onsubmit="return confirm('Are you sure you want to delete this task?');">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </td>
    }
</ul>
<a href="@Url.Action("New", "AppTasks", new { projectId = Model.Id })" class="btn btn-primary">Create Task</a>