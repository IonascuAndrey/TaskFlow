@model TaskFlow.Models.AppTask

@{
    ViewData["Title"] = "Task Details";
}

<h2>Task Details</h2>

<div class="card">
    <div class="card-header">
        <h3>@Model.Title</h3>
    </div>
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Start Date:</strong> @Model.DateStart.ToString("dd MMM yyyy")</p>
        <p><strong>End Date:</strong> @Model.DateEnd.ToString("dd MMM yyyy")</p>
        <p><strong>Project:</strong> @Model.Project?.Title</p>
        <p><strong>Assigned User:</strong></p>
        @if (Model.Users != null && Model.Users.Any())
        {
            <ul>
                @foreach (var user in Model.Users)
                {
                    <li>@user.UserName (@user.Email)</li>
                }
            </ul>
        }
        else
        {
            <span>No users assigned to this task.</span>
        }
        </p>
        @if (!string.IsNullOrEmpty(Model.Media))
        {
            <p><strong>Media:</strong> <a href="@Model.Media" target="_blank">View Media</a></p>
        }
    </div>
</div>

@if (Model.Comments != null && Model.Comments.Any())
{
    <h4>Comments</h4>
    <ul class="list-group">
        @foreach (var comment in Model.Comments)
        {
            <li class="list-group-item">
                <strong>@comment.User?.UserName:</strong> @comment.Content
                <small class="text-muted">(@comment.DateAdd.ToString("dd MMM yyyy HH:mm"))</small>
                <div class="d-flex">
                    <div>
                        <a class="btn btn-outline-primary" asp-asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id">
                            <i class="bi bi-pencil-square"></i> Editeaza
                        </a>
                    </div>
                </div>
                <form method="post" asp-asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id">
                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i>Sterge</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>No comments for this task.</p>
}

<div class="container">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div class="card">
                <form method="post" asp-asp-controller="AppTasks" asp-action="Show">
                    <div class="card-body">
                        <input type="hidden" name="AppTaskId" value="@Model.Id"/>
                        <label>Continut Comentariu</label>
                        <br/>
                        <textarea class="form-control" name="Content"></textarea>
                        <span asp-asp-validation-for="Content" class="text-danger"></span>
                        <br /><br />
                        <button class="btn btn-success" type="submit">Adauga comentariul</button>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Task</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete Task</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Task List</a>
</div>
