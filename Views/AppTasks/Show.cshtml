@model TaskFlow.Models.AppTask
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Task Details";
}

@{
    var isAssigned = ViewBag.IsAssigned;
    var isAdmin = ViewBag.IsAdmin;
    var isAssignedToProjects = ViewBag.IsAssignedToProjects;
}

<div class="background" id="background"></div>

<div class="content">
<h2>Task Details</h2>
<httpCookies requireSSL="true" />
<div class="card">
    <div class="card-header">
        <h3>@Model.Title</h3>
    </div>
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Start Date:</strong> @Model.DateStart.ToString("dd MMM yyyy")</p>
        <p><strong>End Date:</strong> @Model.DateEnd.ToString("dd MMM yyyy")</p>
        <p><strong>Project:</strong> @Model.Project?.Title</p>
        <p><strong>Assigned User:</strong></p>
        <ul>
            @foreach (var user in Model.Users)
            {
                @if (!(await UserManager.IsInRoleAsync(user, "Admin")))
                {
                    <li>@user.FirstName @user.LastName (@user.Email)</li>
                }
            }
        </ul>
        </p>
        @if (!string.IsNullOrEmpty(Model.Media))
        {
            <div class="card" style="width: 18rem;">
                @if (Model.Media.EndsWith(".jpg") || Model.Media.EndsWith(".png") || Model.Media.EndsWith(".gif"))
                {
                    <img src="@Model.Media" class="card-img-top" alt="Media">
                }
                else if (Model.Media.EndsWith(".mp4") || Model.Media.EndsWith(".webm"))
                {
                    <video controls class="card-img-top">
                        <source src="@Model.Media" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                }
                else if (Model.Media.EndsWith(".mp3"))
                {
                    <audio controls class="card-img-top">
                        <source src="@Model.Media" type="audio/mp3">
                        Your browser does not support the audio tag.
                    </audio>
                }
                else
                {
                    <div class="card-body">
                        <p class="card-text">Your browser does not support the media type.</p>
                        <a href="@Model.Media" target="_blank" class="btn btn-primary">Download Media</a>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">Media Info</h5>
                    <p class="card-text">Open media.</p>
                    <a href="@Model.Media" target="_blank" class="btn btn-secondary">View Media</a>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.Comments != null && Model.Comments.Any())
{
    <h4>Comments</h4>
    <ul class="list-group">
        @foreach (var comment in Model.Comments)
        {
            <li class="list-group-item">
                <strong>
                        @if (comment.User != null)
                        {
                        <i class="bi bi-person">  @comment.User.FirstName @comment.User.LastName: </i>
                        }
                </strong>
                @comment.Content
                <small class="text-muted">(@comment.DateAdd.ToString("dd MMM yyyy HH:mm"))</small>
                @if (isAssigned || isAdmin||isAssignedToProjects)
                {
                    <div class="d-flex">
                        <div>
                            <a class="btn btn-outline-primary" asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id">
                                <i class="bi bi-pencil-square"></i> Editeaza
                            </a>

                        </div>
                        <div>
                            <form method="post" asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id">

                                <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i>Sterge</button>

                            </form>
                        </div>
                    </div>
                }
            </li>
        }
    </ul>
}
else
{
    <p>No comments for this task.</p>
}
@if(isAssigned||isAdmin||isAssignedToProjects){
<div class="container">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div class="card">
                <form method="post" asp-controller="AppTasks" asp-action="Show">
                    <div class="card-body">
                        <input type="hidden" name="AppTaskId" value="@Model.Id"/>
                        <label>Continut Comentariu</label>
                        <br/>
                        <textarea class="form-control" name="Content"></textarea>
                        <span asp-asp-validation-for="Content" class="text-danger"></span>
                        <br /><br />
                        <button class="btn btn-success" type="submit">Adauga comentariul</button>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>
}
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Task</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete Task</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Task List</a>
</div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var totalImages = 22;
        var randomImageNumber = Math.floor(Math.random() * totalImages) + 1;
        var imageUrl = '@Url.Content("~/images/")' + randomImageNumber + '.jpg';
        document.getElementById('background').style.backgroundImage = 'url(' + imageUrl + ')';
        document.getElementById('background').style.backgroundSize = 'cover';
        document.getElementById('background').style.backgroundPosition = 'center';
        document.getElementById('background').style.filter = 'blur(8px)';
        document.getElementById('background').style.zIndex = '-1';
    });
</script>

<style>
    .background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
    }

    .content {
        position: relative;
        z-index: 1;
        padding: 20px;
        max-width: 900px;
        margin: 0 auto;
        background-color: rgba(255, 255, 255, 0.8);
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        font-family: 'Arial', sans-serif;
    }

    .card {
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-body p {
        font-size: 1.1em;
    }

    .btn-outline-primary {
        margin-right: 10px;
    }

    .btn-success {
        margin-top: 10px;
    }

    .btn-danger, .btn-secondary {
        margin-top: 10px;
        margin-left: 10px;
    }
</style>