@model TaskFlow.Models.AppTask


<h2>Create Task</h2>

<form asp-action="New" method="post" enctype="multipart/form-data">
    <!-- Hidden Project ID -->
    <input type="hidden" asp-for="ProjectId" />

    <!-- Task Title -->
    <div class="form-group">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <!-- Task Description -->
    <div class="form-group">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- Task Status -->
    <div class="form-group">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-control">
            <option value="Not Started">Not Started</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <!-- Start Date -->
    <div class="form-group">
        <label asp-for="DateStart" class="form-label"></label>
        <input asp-for="DateStart" class="form-control" type="datetime-local" />
        <span asp-validation-for="DateStart" class="text-danger"></span>
    </div>

    <!-- End Date -->
    <div class="form-group">
        <label asp-for="DateEnd" class="form-label"></label>
        <input asp-for="DateEnd" class="form-control" type="datetime-local" />
        <span asp-validation-for="DateEnd" class="text-danger"></span>
    </div>

    <!-- Media Upload -->
    <div class="form-group">
        <label asp-for="Media" class="form-label"></label>
        <input type="file" asp-for="Media" class="form-control" />
        <span asp-validation-for="Media" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary">Create Task</button>
</form>
