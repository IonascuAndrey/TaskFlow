@model TaskFlow.Models.Comment


@{
    var totalImages = 22;
    var random = new Random();
}
<div class="background" id="background"></div>
<div class="content">
<h2 class="text-center">Editare comentariu</h2>
<br />

<form asp-action="Edit" asp-controller="Comments" asp-route-id="@Model.Id" method="post">
    <div class="form-group">
        <label asp-for="Content" class="form-label">Content</label>
        <br />
        <textarea asp-for="Content" class="form-control"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <br /><br />

    <div class="text-center">
        <button class="btn btn-primary" type="submit">Save</button>
    </div>
</form>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var totalImages = 22;
        var randomImageNumber = Math.floor(Math.random() * totalImages) + 1;
        var imageUrl = '@Url.Content("~/images/")' + randomImageNumber + '.jpg';
        document.getElementById('background').style.backgroundImage = 'url(' + imageUrl + ')';
        document.getElementById('background').style.backgroundSize = 'cover';
        document.getElementById('background').style.backgroundPosition = 'center';
        document.getElementById('background').style.filter = 'blur(8px)';
        document.getElementById('background').style.zIndex = '-1';
    });
</script>

<style>
    .background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        z-index: -1;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .content {
        position: relative;
        z-index: 1;
        padding: 20px;
        max-width: 800px;
        margin: 0 auto;
        background-color: rgba(255, 255, 255, 0.8);
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .form-label {
        font-size: 1.1rem;
        font-weight: bold;
        color: #495057;
    }

    .form-control {
        border-radius: 0.5rem;
        border: 1px solid #ced4da;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(38, 143, 255, 0.25);
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        border-radius: 0.5rem;
        padding: 0.5rem 1rem;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }
</style>